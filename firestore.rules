rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'tonny.azin@gmail.com';
    }

    // Delegated supervisors are explicitly authorized by UID in /admins/{uid}
    // by the verified bootstrapped admin (immune to email spoofing).
    function isDelegatedAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isBootstrappedAdmin() || isDelegatedAdmin();
    }

    // --- Validation Blueprints ---
    function isValidSchedule(data) {
      return data.keys().hasAll([
          'monthKey',
          'employeeName',
          'normalizedName',
          'department',
          'shift',
          'days',
          'isPublished',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'monthKey',
          'employeeName',
          'normalizedName',
          'department',
          'shift',
          'days',
          'isPublished',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.monthKey is string
        && data.monthKey.size() == 7
        && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.employeeName is string
        && data.employeeName.size() >= 2
        && data.employeeName.size() <= 80
        && data.normalizedName is string
        && data.normalizedName.size() >= 2
        && data.normalizedName.size() <= 80
        && data.normalizedName.matches('^[a-z0-9 ]+$')
        && data.department is string
        && data.department.size() <= 60
        && data.shift is string
        && data.shift.size() <= 40
        && data.days is map
        && data.days.size() <= 31
        && data.isPublished is bool
        && data.updatedBy is string
        && data.updatedBy.size() >= 1
        && data.updatedBy.size() <= 128
        && data.updatedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['displayName', 'role', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['displayName', 'role', 'createdBy', 'createdAt'])
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 80
        && data.role is string
        && data.role == 'admin'
        && data.createdBy is string
        && data.createdBy.size() >= 1
        && data.createdBy.size() <= 128
        && data.createdBy == request.auth.uid
        && data.createdAt is timestamp;
    }

    // --- Collection: /schedules/{scheduleId} ---
    // Publicly consultable by employees when isPublished == true (contains zero PII).
    // Only authorized supervisors (isAdmin) may create, update, or delete schedules.
    // allow list uses zero DB lookups (no exists/get calls).
    match /schedules/{scheduleId} {
      allow get: if isValidId(scheduleId)
        && ((resource != null && existing().isPublished == true) || isAdmin());
      allow list: if existing().isPublished == true || isBootstrappedAdmin();

      allow create: if isSignedIn()
        && isValidId(scheduleId)
        && isValidSchedule(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update: if isSignedIn()
        && isValidId(scheduleId)
        && isValidSchedule(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().monthKey == existing().monthKey
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'employeeName',
          'normalizedName',
          'department',
          'shift',
          'days',
          'isPublished',
          'updatedBy',
          'updatedAt'
        ])
        && isAdmin();

      allow delete: if isSignedIn()
        && isValidId(scheduleId)
        && isAdmin();
    }

    // --- Collection: /admins/{adminUid} ---
    // Only the verified bootstrapped admin can manage supervisor accounts.
    match /admins/{adminUid} {
      allow get: if isSignedIn()
        && isValidId(adminUid)
        && (request.auth.uid == adminUid || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin() && existing().role == 'admin';

      allow create: if isBootstrappedAdmin()
        && isValidId(adminUid)
        && isValidAdmin(incoming())
        && incoming().createdAt == request.time;

      allow update: if isBootstrappedAdmin()
        && isValidId(adminUid)
        && isValidAdmin(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role']);

      allow delete: if isBootstrappedAdmin()
        && isValidId(adminUid);
    }
  }
}
